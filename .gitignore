# Dependencies
node_modules/

# Build output
dist/
.next/
.turbo/

# Electron compiled output (source is electron/*.ts; compiled JS is generated)
electron/main.js
electron/preload.js
electron/*.js.map

# Electron-builder release artifacts
release/

# Generated desktop icons (source of truth is build/icon.png)
build/icon.icns
build/icon.ico
build/icons/

# Tauri build output (source is src-tauri/; target/ and gen/ are generated)
src-tauri/target/
src-tauri/gen/
# macOS-style global gitignores often contain `Icon?`, which also matches
# the src-tauri/icons/ directory — re-include the Tauri icon set explicitly.
!src-tauri/icons/
# The same pattern hides the web app's icons, which build-app-icons.mjs writes
# and which are committed: the manifest and the service worker list them.
!packages/client/public/icons/
!packages/client/public/icons/*.png

# Capacitor-generated native projects (created by `cap add ios|android`)
# Comment these out if you want to commit the native Xcode / Gradle projects.
ios/
android/

# Next.js static export output (produced by `NEXT_FILE_EXPORT=1 pnpm build`)
packages/client/out/

# RDKit staged into public/ by packages/client/scripts/copy-rdkit.mjs: a
# 6.9 MB wasm, the emscripten glue, the esbuild-bundled worker and the
# generated licence notice. All four are derived from node_modules and
# regenerate on every dev/build/test run.
packages/client/public/rdkit/

# The 3D view's conformer worker (OpenChemLib bundled by esbuild) and its
# licence notice, staged by packages/client/scripts/copy-conformer.mjs on
# every dev/build/test run.
packages/client/public/conformer/

# The 1200x630 link-preview image, rendered from the landing's example figure
# by packages/client/scripts/build-social-card.mjs on every dev/build run.
packages/client/public/social-card.png
# One per guide, from its first figure, by the same script (decision 245).
packages/client/public/social-cards/

# The service worker, bundled with this build's precache list by
# packages/client/scripts/build-service-worker.mjs after every web build.
packages/client/public/sw.js

# Environment (committed: .env.example, .env.development, AND
#              .env.production — because production values are
#              encrypted via dotenvx, not plaintext).
#
# .env.keys must NEVER be committed — it contains the private keys
# that decrypt the encrypted values in .env.production.
.env
.env.local
.env.keys
.env.*.local

# IDE
.vscode/
!.vscode/settings.json
.idea/

# OS
.DS_Store
Thumbs.db

# Testing
test-results/
playwright-report/
coverage/

# Docker
.docker-data/

# TypeScript
*.tsbuildinfo

# Misc
*.log
npm-debug.log*
