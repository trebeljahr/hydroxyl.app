  "scripts": {
    "dev": "node scripts/dev-preflight.mjs && node scripts/copy-rdkit.mjs && node scripts/build-social-card.mjs && NODE_OPTIONS=\"$NODE_OPTIONS --heapsnapshot-near-heap-limit=1 --diagnostic-dir=.next/heap-snapshots\" next dev --port ${PORT:-6337}",
