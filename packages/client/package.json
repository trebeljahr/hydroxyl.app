    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@starter/chem-core": "workspace:*",
    "@starter/chem-render": "workspace:*",
    "@starter/shared": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "immer": "^11.1.18",
    "lucide-react": "^1.16.0",
    "next": "^16.3.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
