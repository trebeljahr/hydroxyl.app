    "start": "next start --port ${PORT:-6337}",
    "lint": "eslint .",
    "test": "node scripts/copy-rdkit.mjs && vitest run",
    "typecheck": "tsc --noEmit",
    "build:dictionary": "node scripts/build-structure-dictionary.mjs"
  },
  "dependencies": {
